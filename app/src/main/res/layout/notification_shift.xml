<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открытая смена"
        android:textColor="#1E2A32"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#1E2A32"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_ibd_dec"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_dec"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="ИБДР −"
            android:textColor="#1E2A32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ibd_inc"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_inc"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="ИБДР +"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_migrant_dec"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_dec"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Мигрант −"
            android:textColor="#1E2A32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_migrant_inc"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_inc"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Мигрант +"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_migrant_ibdr_dec"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_dec"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Мигр+ИБДР −"
            android:textColor="#1E2A32"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_migrant_ibdr_inc"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_inc"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Мигр+ИБДР +"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_admin"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_admin"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Админка"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_criminal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_criminal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="Уголовка"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
